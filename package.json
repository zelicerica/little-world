{
  "name": "little-world",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev": "npm start",
    "start": "node --env-file-if-exists=.env.local server/start.mjs",
    "security:secrets": "node scripts/check-secrets.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.96",
    "ai": "^7.0.143"
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
