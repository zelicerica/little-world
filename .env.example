# Copy to .env.local on your own computer. Never commit .env.local or paste a key into chat.
OPENAI_API_KEY=
LITTLE_WORLD_AI_ENABLED=false
LITTLE_WORLD_MODEL=gpt-5.4-mini
# Shared across tabs; resets only when the server restarts. Failures consume an attempt.
LITTLE_WORLD_MAX_REQUESTS=20
LITTLE_WORLD_MAX_OUTPUT_TOKENS=256
LITTLE_WORLD_TIMEOUT_MS=8000
PORT=4173
